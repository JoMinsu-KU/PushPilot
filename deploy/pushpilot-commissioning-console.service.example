[Unit]
Description=PushPilot isolated commissioning workbench (no automatic motion)
After=network-online.target pushpilot-main.service

[Service]
Type=simple
WorkingDirectory=/home/OPERATOR/pushpilot-commissioning-console/current
ExecStart=/home/OPERATOR/pushpilot-app/current/.venv/bin/python -B tools/serve_commissioning_console.py --config /home/OPERATOR/pushpilot-app/shared/physical-delivery-20261029/delivery-driver.private.json --state /home/OPERATOR/pushpilot-commissioning-console/shared/state --token-file /home/OPERATOR/pushpilot-commissioning-console/shared/console.token --host 0.0.0.0 --port 8192 --allowed-host 127.0.0.1:8192 --allowed-host TABLET_LAN_IP:8192
Restart=on-failure
RestartSec=5
TimeoutStopSec=infinity
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
