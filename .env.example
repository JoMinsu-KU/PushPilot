# Proposed application configuration. The bootstrap tools do not read this file.
# Copy to an ignored .env only when the runtime explicitly supports these fields.
# Never paste credentials into chat, source control or a release package.
PUSHPILOT_RUN_MODE=simulation
PUSHPILOT_PROVIDER_MODE=mock
PUSHPILOT_BIND_HOST=127.0.0.1
PUSHPILOT_STATE_DIR=./runtime
META_API_KEY=
