# The backend loads this optional local file at server startup.
# Environment variables take precedence. The connection checker also reads META_API_KEY.
# Never paste credentials into chat, source control or a release package.
# Simulation is the default. Physical activation needs a separate qualified private release.
PUSHPILOT_STATE_PATH=./runtime/workspace.sqlite3
# Optional replacements; changing the map invalidates old plans and test registrations.
# PUSHPILOT_MAP_PATH=./backend/data/little-town-temporary.json
# PUSHPILOT_SCENE_DIR=./runtime/scene
META_API_KEY=
# Process environment only; not loaded from this file:
# PUSHPILOT_PHYSICAL_CONFIG=/absolute/private/path/physical-mission.json
